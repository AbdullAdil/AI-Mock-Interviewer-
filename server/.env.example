# Get yours from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Port the backend listens on locally. Railway sets this automatically in production.
PORT=3001

# Comma-separated list of allowed frontend origins for CORS.
# Locally: http://localhost:5173
# In production: your Vercel URL, e.g. https://ai-mock-interviewer.vercel.app
CLIENT_ORIGIN=http://localhost:5173
